@model TooL82.Web.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "회원가입";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">회원가입</h4>
            </div>
            <div class="card-body">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" placeholder="이름을 입력하세요" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="UserId"></label>
                        <div class="input-group">
                            <input asp-for="UserId" class="form-control" placeholder="아이디를 입력하세요" id="userId" />
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary" onclick="checkUserId()">중복확인</button>
                            </div>
                        </div>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                        <small id="userIdCheck" class="form-text"></small>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" placeholder="비밀번호를 입력하세요" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="비밀번호를 다시 입력하세요" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" placeholder="이메일을 입력하세요" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="IsSeller" class="form-check-input" />
                        <label asp-for="IsSeller" class="form-check-label">판매자로 등록하기</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">가입하기</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function checkUserId() {
            var userId = $('#userId').val();
            if (!userId) {
                $('#userIdCheck').text('아이디를 입력하세요').removeClass('text-success').addClass('text-danger');
                return;
            }

            $.get('@Url.Action("CheckUserId", "Account")', { uid: userId }, function(result) {
                if (result === '1') {
                    $('#userIdCheck').text('이미 사용중인 아이디입니다').removeClass('text-success').addClass('text-danger');
                } else {
                    $('#userIdCheck').text('사용 가능한 아이디입니다').removeClass('text-danger').addClass('text-success');
                }
            });
        }
    </script>
}
