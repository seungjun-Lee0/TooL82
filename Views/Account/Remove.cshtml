@{
    ViewData["Title"] = "회원 탈퇴";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">회원 탈퇴</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <strong>주의!</strong> 회원 탈퇴 시 모든 데이터가 삭제됩니다.
                    <br>진행 중인 구매/판매가 있는 경우 탈퇴가 불가능합니다.
                </div>

                <form asp-action="Remove" method="post">
                    <div class="form-group">
                        <label>비밀번호 확인</label>
                        <input type="password" name="password" class="form-control" placeholder="비밀번호를 입력하세요" required />
                    </div>

                    <button type="submit" class="btn btn-danger btn-block" onclick="return confirm('정말 탈퇴하시겠습니까?')">탈퇴하기</button>
                    <a href="@Url.Action("MyPage")" class="btn btn-secondary btn-block">취소</a>
                </form>
            </div>
        </div>
    </div>
</div>
