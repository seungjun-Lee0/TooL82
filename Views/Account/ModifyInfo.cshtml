@model TooL82.Web.Models.ViewModels.ModifyInfoViewModel
@{
    ViewData["Title"] = "정보 수정";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">정보 수정</h4>
            </div>
            <div class="card-body">
                <form asp-action="ModifyInfo" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label>아이디</label>
                        <input type="text" class="form-control" value="@Model?.UserId" readonly />
                    </div>

                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" placeholder="새 비밀번호를 입력하세요" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="IsSeller" class="form-check-input" />
                        <label asp-for="IsSeller" class="form-check-label">판매자 등록</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">수정하기</button>
                    <a href="@Url.Action("MyPage")" class="btn btn-secondary btn-block">취소</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
