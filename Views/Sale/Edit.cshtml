@model TooL82.Web.Models.Entities.Product
@{
    ViewData["Title"] = "상품 수정";
    var category = Model?.Category ?? "";
}

<h2 class="mb-4">상품 수정</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" name="Pno" value="@Model?.Pno" />
            <input type="hidden" name="UserId" value="@Model?.UserId" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>카테고리</label>
                        <select name="Category" class="form-control" required>
                            @if (category == "g") { <option value="g" selected>게임</option> } else { <option value="g">게임</option> }
                            @if (category == "m") { <option value="m" selected>음악</option> } else { <option value="m">음악</option> }
                            @if (category == "v") { <option value="v" selected>영상</option> } else { <option value="v">영상</option> }
                            @if (category == "u") { <option value="u" selected>유틸</option> } else { <option value="u">유틸</option> }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>상품명</label>
                        <input type="text" name="Title" class="form-control" value="@Model?.Title" required />
                    </div>

                    <div class="form-group">
                        <label>원가</label>
                        <input type="number" name="OPrice" class="form-control" value="@Model?.OPrice" required />
                    </div>

                    <div class="form-group">
                        <label>판매가</label>
                        <input type="number" name="SPrice" class="form-control" value="@Model?.SPrice" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>모집 인원</label>
                        <input type="number" name="Party" class="form-control" value="@Model?.Party" required />
                    </div>

                    <div class="form-group">
                        <label>마감일</label>
                        <input type="date" name="EDate" class="form-control" value="@Model?.EDate.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="form-group">
                        <label>연락용 이메일</label>
                        <input type="email" name="Email" class="form-control" value="@Model?.Email" />
                    </div>

                    <div class="form-group">
                        <label>현재 이미지</label>
                        @if (!string.IsNullOrEmpty(Model?.FNames))
                        {
                            <div class="mb-2">
                                @foreach (var fname in Model.FNames.Split(','))
                                {
                                    <img src="/uploads/@fname" class="img-thumbnail mr-2" style="width: 100px; height: 100px; object-fit: cover;">
                                }
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="deleteFiles" value="true" class="form-check-input" id="deleteFiles">
                                <label class="form-check-label" for="deleteFiles">기존 이미지 삭제</label>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">등록된 이미지가 없습니다.</p>
                        }
                    </div>

                    <div class="form-group">
                        <label>새 이미지 (선택)</label>
                        <input type="file" name="files" class="form-control-file" multiple accept="image/*" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>상품 설명</label>
                <textarea name="Contents" class="form-control" rows="10">@Model?.Contents</textarea>
            </div>

            <button type="submit" class="btn btn-primary">수정하기</button>
            <a href="@Url.Action("SellerPage", "Purchase")" class="btn btn-secondary">취소</a>
        </form>
    </div>
</div>
