@model TooL82.Web.Models.Entities.Product
@{
    ViewData["Title"] = "상품 등록";
}

<h2 class="mb-4">상품 등록</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>카테고리</label>
                        <select name="Category" class="form-control" required>
                            <option value="">선택하세요</option>
                            <option value="g">게임</option>
                            <option value="m">음악</option>
                            <option value="v">영상</option>
                            <option value="u">유틸</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>상품명</label>
                        <input type="text" name="Title" class="form-control" required placeholder="상품명을 입력하세요" />
                    </div>

                    <div class="form-group">
                        <label>원가</label>
                        <input type="number" name="OPrice" class="form-control" required placeholder="원가를 입력하세요" />
                    </div>

                    <div class="form-group">
                        <label>판매가</label>
                        <input type="number" name="SPrice" class="form-control" required placeholder="판매가를 입력하세요" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>모집 인원</label>
                        <input type="number" name="Party" class="form-control" required placeholder="모집 인원을 입력하세요" />
                    </div>

                    <div class="form-group">
                        <label>마감일</label>
                        <input type="date" name="EDate" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>연락용 이메일</label>
                        <input type="email" name="Email" class="form-control" placeholder="이메일을 입력하세요" />
                    </div>

                    <div class="form-group">
                        <label>상품 이미지</label>
                        <input type="file" name="files" class="form-control-file" multiple accept="image/*" />
                        <small class="form-text text-muted">여러 이미지를 선택할 수 있습니다.</small>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>상품 설명</label>
                <textarea name="Contents" class="form-control" rows="10" placeholder="상품에 대한 상세 설명을 입력하세요"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">등록하기</button>
            <a href="@Url.Action("SellerPage", "Purchase")" class="btn btn-secondary">취소</a>
        </form>
    </div>
</div>
