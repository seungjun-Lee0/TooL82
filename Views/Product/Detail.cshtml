@model TooL82.Web.Models.Entities.Product
@{
    ViewData["Title"] = Model?.Title ?? "상품 상세";
    var category = ViewBag.Category as string ?? Model?.Category ?? "g";
    var categoryName = category switch {
        "g" => "게임",
        "m" => "음악",
        "v" => "영상",
        "u" => "유틸",
        _ => "기타"
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">홈</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("List", new { category })">@categoryName</a></li>
        <li class="breadcrumb-item active">@Model?.Title</li>
    </ol>
</nav>

@if (Model != null)
{
    var imageUrl = !string.IsNullOrEmpty(Model.FNames)
        ? "/uploads/" + Model.FNames.Split(',')[0]
        : "https://via.placeholder.com/600x400?text=No+Image";

    <div class="row">
        <div class="col-md-6">
            <img src="@imageUrl" class="img-fluid rounded" alt="@Model.Title">

            @if (!string.IsNullOrEmpty(Model.FNames) && Model.FNames.Contains(","))
            {
                <div class="row mt-3">
                    @foreach (var fname in Model.FNames.Split(',').Skip(1).Take(4))
                    {
                        <div class="col-3">
                            <img src="/uploads/@fname" class="img-thumbnail" alt="추가 이미지">
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-md-6">
            <h2>@Model.Title</h2>
            <hr>

            <div class="mb-3">
                <span class="original-price" style="font-size: 1.2em;">@Model.OPrice.ToString("N0")원</span>
                <span class="price-info" style="font-size: 1.8em; margin-left: 10px;">@Model.SPrice.ToString("N0")원</span>
                <span class="badge badge-danger ml-2">@Model.PriceRate% 할인</span>
            </div>

            <table class="table">
                <tr>
                    <th>판매자</th>
                    <td>@Model.UserId</td>
                </tr>
                <tr>
                    <th>모집 인원</th>
                    <td>@Model.CPartied / @Model.Party 명</td>
                </tr>
                <tr>
                    <th>진행률</th>
                    <td>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-success" style="width: @Model.PartyRate%">@Model.PartyRate%</div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <th>마감일</th>
                    <td>@Model.EDate.ToString("yyyy-MM-dd") (D-@Model.LeftDays)</td>
                </tr>
                <tr>
                    <th>상태</th>
                    <td>
                        @if (Model.IsClosed)
                        {
                            <span class="badge badge-secondary">마감</span>
                        }
                        else
                        {
                            <span class="badge badge-success">모집중</span>
                        }
                    </td>
                </tr>
            </table>

            @if (!Model.IsClosed)
            {
                <form asp-action="Buy" method="post">
                    <input type="hidden" name="pno" value="@Model.Pno" />
                    <input type="hidden" name="category" value="@Model.Category" />
                    <input type="hidden" name="title" value="@Model.Title" />
                    <input type="hidden" name="edate" value="@Model.EDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="sprice" value="@Model.SPrice" />
                    <button type="submit" class="btn btn-primary btn-lg btn-block">공동구매 참여하기</button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary btn-lg btn-block" disabled>마감된 상품입니다</button>
            }
        </div>
    </div>

    <div class="mt-5">
        <h4>상품 설명</h4>
        <hr>
        <div class="p-3 bg-light rounded">
            @Html.Raw(Model.Contents?.Replace("\n", "<br>") ?? "상품 설명이 없습니다.")
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">상품을 찾을 수 없습니다.</div>
}
