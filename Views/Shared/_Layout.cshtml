@using System.Text.Json
@{
    var memberJson = Context.Session.GetString("MyInfo");
    TooL82.Web.Models.Entities.Member? currentUser = null;
    if (!string.IsNullOrEmpty(memberJson))
    {
        currentUser = JsonSerializer.Deserialize<TooL82.Web.Models.Entities.Member>(memberJson);
    }
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - TooL82</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" integrity="sha384-B0vP5xmATw1+K9KRQjQERJvTumQW0nPEzvF6L/Z6nronJ3oUOFUFpCjEUQouq2+l" crossorigin="anonymous" />

    <!-- Font Awesome -->
    <script src="https://kit.fontawesome.com/dd1a91c868.js" crossorigin="anonymous"></script>

    <!-- User define CSS -->
    <link rel="stylesheet" href="~/css/personal/products.css" />

    <!-- Theme CSS -->
    <link rel="stylesheet" href="~/css/buts/default_shop.css" />
    <link rel="stylesheet" href="~/css/buts/apms.css" />
    <link rel="stylesheet" href="~/css/buts/magnific_popup.css" />
    <link rel="stylesheet" href="~/css/buts/buts.css" />
    <link rel="stylesheet" href="~/css/buts/widget.css" />
    <link rel="stylesheet" href="~/css/buts/bagic.css" />

    <!-- jQuery UI for datepicker -->
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" />
</head>
<body>
<div class="main">
    <!-- Topper -->
    <div class="topper">
        <div class="width-container">
            <div class="topper-menu">
                @if (currentUser == null)
                {
                    <a href="@Url.Action("RegAgree", "Account")" class="v-bar">회원가입</a>
                }
                else
                {
                    <a href="@Url.Action("MyPage", "Account")" class="v-bar">마이페이지</a>
                }
            </div>
        </div>
    </div>

    <!-- Header -->
    <div class="header">
        <div class="width-container">
            <div class="header-logo" style="margin-top: -35px;">
                <a href="/"><img src="~/banner/tool82_logo.jpeg" height="90" width="100" alt="logo" /></a>
            </div>
            <div class="header-right">
                @if (currentUser != null && currentUser.SellerYn == "Y")
                {
                    <a href="@Url.Action("Create", "Sale")" class="header-button">판매 등록</a>
                }
                @if (currentUser == null)
                {
                    <a class="header-button" href="@Url.Action("Login", "Account")">로그인</a>
                }
                else
                {
                    <a class="header-button" href="@Url.Action("Logout", "Account")" id="logoutbtn">로그아웃</a>
                }
            </div>
        </div>

        <div class="header-menu pc">
            <ul>
                <li class="menu-li off">
                    <a id="movie" href="@Url.Action("List", "Product", new { category = "v" })" class="menu-a">영상<span class="menu_new"></span></a>
                    <div class="sub-menu" style="display: none">
                        <div class="sub-width">
                            <div class="sub-tip">
                                <span class="text-purple">영상</span> 인기 카테고리
                            </div>
                        </div>
                    </div>
                </li>
                <li class="menu-li off">
                    <a href="@Url.Action("List", "Product", new { category = "m" })" class="menu-a">음악</a>
                    <div class="sub-menu" style="display: none">
                        <div class="sub-width">
                            <div class="sub-tip">
                                <span class="text-purple">도서/음악</span> 인기 카테고리
                            </div>
                        </div>
                    </div>
                </li>
                <li class="menu-li off">
                    <a href="@Url.Action("List", "Product", new { category = "g" })" class="menu-a">게임</a>
                    <div class="sub-menu" style="display: none">
                        <div class="sub-width">
                            <div class="sub-tip">
                                <span class="text-purple">게임</span> 인기 카테고리
                            </div>
                        </div>
                    </div>
                </li>
                <li class="menu-li off">
                    <a href="@Url.Action("List", "Product", new { category = "u" })" class="menu-a">유틸</a>
                    <div class="sub-menu" style="display: none">
                        <div class="sub-width">
                            <div class="sub-tip">
                                <span class="text-purple">유틸</span> 인기 카테고리
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container" style="margin-top: 150px; margin-bottom: 150px">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
        <a href="#" class="top" style="color: white">Top</a>
    </div>

    <!-- Footer -->
    <div class="footer">
        <div class="width-container">
            <div class="padding-left">
                <div class="footer-logo" style="margin-top: -35px">
                    <img src="~/banner/tool82_logo_grey.jpeg" height="97" width="100" alt="footer_logo" />
                </div>
                <span>Copyright &copy; 2021 TooL82 Inc. All rights reserved.</span>
            </div>
        </div>
    </div>

    <div class="footer">
        <div class="width-container">
            TooL82는 통신판매중개자이며, 통신판매의 당사자가 아닙니다. 파티정보, 구매에 관한 의무와 책임은 판매자에게 있습니다.<br />
            TooL82는 소비자 보호와 안전거래를 위해 고객센터(manager@TooL82.co.kr)를 운영하고 있으며, 분쟁이 발생 된 경우 별도의 분쟁처리절차에 의거 분쟁해결 및 청약철회 등이 진행 됩니다.
        </div>
    </div>
</div>

<!-- jQuery and Bootstrap Bundle (includes Popper) -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-Piv4xVNRyMGpqkS2by6br4gNJ7DXjqk09RmUpJ8jgGtD7zP9yug3goQfGII0yAns" crossorigin="anonymous"></script>

<!-- jQuery UI for datepicker -->
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

<!-- Load custom JS files -->
<script src="~/js/modal.js"></script>
<script src="~/js/register.js"></script>
<script src="~/js/product.js"></script>
<script src="~/js/sale.js"></script>
<script src="~/js/buysell.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
